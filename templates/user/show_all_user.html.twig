{% extends "base.html.twig" %}

{% block title %}Liste des utilisateur{% endblock %}

{% block body %}
    <section>
        {% if users %}
        <h1>Liste des utilisateur</h1>
            {% for user in users %}
                <ul>
                    <li>{{ user.firstname }}</li>
                    <li>{{ user.lastname }}</li>
                    <li>{{ user.email }}</li>
                </ul>
            {% endfor %}
        {% else %}
        <h2>La liste est vide</h2>
        {% endif %}
    </section>  
{% endblock %}