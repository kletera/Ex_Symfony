{% extends 'base.html.twig' %}

{% block title %}Météo{% endblock %}

{% block body %}
<div class="flex flex-col justify-center items-center bg-base-200 gap-6">

    <div class="card w-96 bg-base-100 shadow-xl">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="form-control gap-2">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                    {{ form_rest(form) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>

     <twig:Toast/>


    {% if data %}
        <div class="card w-96 bg-base-100 shadow-xl">
            <figure class="pt-6">
                <img
                    src="https://openweathermap.org/img/wn/{{ data.weather[0].icon }}@2x.png"
                    alt="{{ data.weather[0].main }}"
                    class="w-40 h-40"
                />
            </figure>

            <div class="card-body items-center text-center pt-0">
                <h2 class="card-title text-3xl">{{ data.name }}</h2>

                <div class="stat">
                    <div class="stat-title">Température</div>
                    <div class="stat-value text-primary">
                        {{ (data.main.temp - 273.15)|round(1) }} °C
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}