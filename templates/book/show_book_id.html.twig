{% extends 'base.html.twig' %}

{% block title %}Détail du livre par id{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    
    {% if book %}
        <h1>Détail du livre par son id</h1>
        <h2>{{book.title}}</h2>
        <ul>
            <li>Resumer :{{book.resume}}</li>
            <li>Date de publication : {{ book.publishAt | date("d-m-Y") }}</li>
            <li>Autheur :{{book.author}}</li>
        </ul>
        <a href="{{ path('app_books') }}">
            Voir la liste des livres
        </a>
    {% else %}
        <h1>Erreur 404 : Aucun livre trouver</h1>
    {% endif %}   
</div>
{% endblock %}
