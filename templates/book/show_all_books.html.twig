{% extends 'base.html.twig' %}

{% block title %}Liste des livres{% endblock %}

{% block body %}

    <div class="container mx-auto max-w-4xl px-4 py-8">

        <div class="flex items-center justify-between gap-4 mb-6">
            <h1 class="text-3xl font-bold">Liste des livres</h1>
            <a href="{{ path('app_book_new') }}" class="btn btn-neutral">
                + Ajouter un livre
            </a>
        </div>

        {% if books %}
            <ul class="grid gap-4">
                {% for book in books %}
                    <li class="card bg-base-100 shadow-sm">
                        <div class="card-body gap-4">
                            <div>
                                <p class="text-xs font-medium uppercase tracking-widest text-base-content/50">
                                    {{ book.author }}
                                </p>
                                <h2 class="card-title mt-3 text-xl">{{ book.title }}</h2>
                            </div>
                            <div class="card-actions justify-end">
                                {# <a href="{{ path('app_book_edit', {id: book.id}) }}"
                                   class="btn btn-sm btn-outline btn-neutral">
                                    ✏️ Modifier
                                </a> #}
                                <a href="{{ path('app_book_id', {id: book.id}) }}"
                                   class="btn btn-sm btn-neutral">
                                    Voir le détail →
                                </a>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div role="alert" class="alert">
                <span>Aucun livre trouvé</span>
            </div>
        {% endif %}

    </div>

{% endblock %}