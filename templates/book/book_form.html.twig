{% extends 'base.html.twig' %}
{% block title %}Ajouter un livre{% endblock %}
{% block body %}
<h1>Ajouter un Livre</h1>
{{ form_start(form, {
    'attr': {'class': 'flex flex-col gap-6 max-w-2xl'}
    }) 
}}
    <div class="flex flex-col">
        {{ form_label(form.title) }}
        {{ form_widget(form.title) }}
        {{ form_errors(form.title) }}
    </div>
    <div class="flex flex-col">
        {{ form_label(form.resume) }}
        {{ form_widget(form.resume) }}
        {{ form_errors(form.resume) }}
    </div>
   

    <div class="flex flex-col">
        {{ form_label(form.author) }}
        {{ form_widget(form.author) }}
        {{ form_errors(form.author) }}
    </div>
    
    
    <div class="flex flex-col">
        {{ form_label(form.publishAt) }}
        {{ form_widget(form.publishAt) }}
        {{ form_errors(form.publishAt) }}
    </div>

    <div class="flex flex-col">
        {{ form_label(form.categories) }}
        {{ form_widget(form.categories)}}
    </div>
    

    {{ form_rest(form) }}
{{ form_end(form) }}
<twig:Toast/>
{% endblock %}