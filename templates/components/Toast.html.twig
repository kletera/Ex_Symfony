{# templates/components/Toast.html.twig #}
{% if  app.flashes('notice') %}
    {% for message in app.flashes('notice') %}
        <div class="flash-notice">
            <twig:Alert :message="message" type="success" />
        </div>
    {% endfor %}
{% else %}
{% for message in app.flashes('error') %}
        <div class="flash-notice">
            <twig:Alert :message="message" type="error" />
        </div>
    {% endfor %}
{% endif %}