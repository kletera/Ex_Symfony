<a href="/" class="btn btn-neutral fixed left-4 top-4 z-50 -translate-y-24 focus:translate-y-0">Aller au contenu</a>
<header class="border-b border-base-300 bg-base-100">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8">
        <div class="flex flex-wrap items-center gap-6">
            <a href="{{ path('app_books') }}" class="text-xl font-semibold tracking-tight">Bibliothèque<span
                    class="text-base-content/40">.</span></a>

            {% set current_route = app.request.attributes.get('_route') %}
            <nav aria-label="Navigation principale" class="flex flex-wrap gap-1">

                {% set navigation=[
                    {label: 'Livres', route: 'app_books'}, 
                    {label: 'Catégories', route:'app_categories'},
                    {label: 'Ajouter categories', route:'app_category_new'},
                ] %}

                {% for item in navigation %}
                   
                    {% set active = current_route == item.route %}
                    <a href="{{ path(item.route) }}" class="btn btn-sm {{ active ? 'btn-neutral' : 'btn-ghost' }}" {% if active
                    %} aria-current="page" {% endif %}>{{ item.label }}</a>
                        
                {% endfor %}
            </nav>
        </div>

        {% if  app.user.userIdentifier is defined %}
             <a href="{{ logout_path() }}" class="btn btn-sm btn-ghost">Déconnexion</a>
        {% else %}
            <nav aria-label="Compte" class="flex flex-wrap gap-1">
                {# Connexion #}
                {% set active = current_route =='app_login' %}
                <a href="{{ path('app_login') }}" class="btn btn-sm {{ active ? 'btn-neutral' : 'btn-ghost' }}" {% if active
                %} aria-current="page" {% endif %}>Connexion</a>

                {# Inscription #}
                {% set active = current_route == 'app_register' %}
                <a href="{{ path('app_register') }}" class="btn btn-sm {{ active ? 'btn-neutral' : 'btn-outline' }}" {% if active
                %} aria-current="page" {% endif %}>Inscription</a>
            </nav>
        {% endif %}
    </div>
</header>